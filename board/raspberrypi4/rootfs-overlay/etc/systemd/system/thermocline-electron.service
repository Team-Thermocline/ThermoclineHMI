[Unit]
Description=Thermocline HMI Electron Application
After=graphical.target xserver.service
Wants=graphical.target xserver.service

[Service]
Type=simple
User=thermocline
# D-Bus: use system bus (no session bus for system service)
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/tmp
# GPU: access DRI for Mesa GL/GLX (thermocline must be in video group)
SupplementaryGroups=video
# X runs with -ac so thermocline can connect to :0
ExecStart=/opt/thermocline-electron/thermocline-electron
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
