{
  "name": "thermocline-electron",
  "productName": "thermocline-electron",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "start:dev": "THERMOCLINE_DEV=1 electron-forge start",
    "package": "electron-forge package",
    "package:pi": "electron-forge package --platform=linux --arch=arm64",
    "package:pi:docker": "bash scripts/package-pi-docker.sh",
    "package:pi32": "electron-forge package --platform=linux --arch=armv7l",
    "make": "electron-forge make",
    "make:pi": "electron-forge make --platform=linux --arch=arm64",
    "make:pi32": "electron-forge make --platform=linux --arch=armv7l",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [],
  "author": {
    "name": "KenwoodFox",
    "email": "joe@kitsunehosting.net"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-webpack": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.3",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "electron": "40.4.1",
    "electron-rebuild": "^3.2.9",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4",
    "svelte": "^4.2.20",
    "svelte-loader": "^3.2.4"
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "serialport": "^12.0.0",
    "uplot": "^1.6.32"
  }
}
